# Copy this file to .env and change the values. Never commit the real .env.

# PostgreSQL
DB_NAME=pulse
DB_USERNAME=pulse
DB_PASSWORD=pulse

# JWT (required). Use a long random value, at least 32 characters.
# For example: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# Origins allowed to call the API (web app and Ionic app in the browser)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8100

# Object storage (S3 compatible: RustFS in docker-compose)
MINIO_ACCESS_KEY=pulse
MINIO_SECRET_KEY=pulsesecret
MINIO_BUCKET=pulse-attachments
MAX_FILE_SIZE_BYTES=10485760

# Links in emails point here
FRONTEND_URL=http://localhost:4200

# Email: false prints emails in the backend log (development only).
# To send real email set MAIL_ENABLED=true plus SPRING_MAIL_HOST, SPRING_MAIL_PORT,
# SPRING_MAIL_USERNAME and SPRING_MAIL_PASSWORD.
MAIL_ENABLED=false
MAIL_FROM=no-reply@pulse.local

# Rate limiting / brute force protection
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
MAX_FAILED_LOGINS=5
LOGIN_LOCK_MINUTES=15

# Host ports (change them if they are already used by something else on your machine)
DB_PORT=5432
REDIS_PORT=6379
STORAGE_PORT=9000
BACKEND_PORT=8080
FRONTEND_PORT=4200
